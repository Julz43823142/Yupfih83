{
  "private": true,
  "description": "Cloudflare Pages Functions dependencies for EloScanner",
  "dependencies": {
    "@better-auth/passkey": "1.7.17",
    "@noble/hashes": "2.4.0",
    "better-auth": "1.7.17",
    "glin-profanity": "4.0.1",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "wrangler": "4.157.0"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test:auth": "node --test --test-concurrency=4 --test-force-exit --test-timeout=120000 tests/auth/*.test.mjs",
    "auth:provision": "node scripts/provision-auth-user.mjs",
    "dev:auth": "node scripts/dev-auth.mjs",
    "auth:migrate:local": "wrangler d1 migrations apply AUTH_DB --local --config tests/auth/wrangler.jsonc",
    "auth:benchmark": "node scripts/benchmark-auth-cpu.mjs"
  }
}
